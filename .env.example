# Core provider settings
COGEVAL_DEFAULT_PROVIDER=mock
COGEVAL_MODEL_OPENAI=gpt-4o-mini
COGEVAL_MODEL_DEEPSEEK=deepseek-chat
COGEVAL_MODEL_WANAI=wanai-chat

# Place your real API keys here (used by LangChain-backed OpenAI client)
COGEVAL_OPENAI_API_KEY=sk-REPLACE_ME
# Or rely on the standard OPENAI_API_KEY
# OPENAI_API_KEY=sk-REPLACE_ME

# Storage locations
COGEVAL_DB_PATH=./cogeval.db
COGEVAL_RAG_INDEX=./rag_index
